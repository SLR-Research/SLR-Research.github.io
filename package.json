{
  "name": "slr-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Nulis — static frontend (GitHub Pages). Tailwind + DaisyUI compiled to a single app.css instead of the Play CDN.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.15",
    "daisyui": "4.12.10",
    "tailwindcss": "3.4.13"
  }
}
